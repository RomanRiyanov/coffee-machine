---
import { business } from '../data/business';

interface Props {
  /** Сколько кадров в public/frames. */
  frameCount?: number;
}
const { frameCount = 103 } = Astro.props;
---

<section class="hero" data-frame-count={frameCount} aria-label="Ремонт кофемашин">
  <div class="hero__sticky">
    <canvas class="hero__canvas" aria-hidden="true"></canvas>

    <div class="hero__loader" aria-hidden="true">
      <div class="hero__loader-bar"><span></span></div>
    </div>

    <!-- Десктопный оверлей: скрыт на мобильных -->
    <div class="hero__overlay">
      <div class="hero__card">
        <p class="hero__eyebrow">{business.areaServed} · сервисный центр</p>
        <h1 class="hero__title">{business.name}<span set:html={business.tagline.replace('—', '—<br>')} /></h1>
        <div class="hero__actions">
          <a
            class="btn btn--primary btn-call"
            href={`tel:${business.phoneHref}`}
            data-phone={business.phone}
          >
            Позвонить · {business.phone}
          </a>
          <a class="btn btn--ghost" href="#services">Услуги и цены</a>
        </div>
        <p class="hero__copied" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<!-- Мобильный блок: появляется ниже всей скролл-секции -->
<div class="hero__mobile">
  <p class="hero__eyebrow">{business.areaServed} · сервисный центр</p>
  <h1 class="hero__title">{business.name}<span set:html={business.tagline.replace('—', '—<br>')} /></h1>
  <div class="hero__actions">
    <a
      class="btn btn--primary btn-call"
      href={`tel:${business.phoneHref}`}
      data-phone={business.phone}
    >
      Позвонить · {business.phone}
    </a>
    <a class="btn btn--ghost" href="#services">Услуги и цены</a>
  </div>
  <p class="hero__copied" aria-live="polite"></p>
</div>

<script>
  import { ScrollFrames } from '../scripts/scroll-frames';

  const section = document.querySelector<HTMLElement>('.hero');
  const canvas = section?.querySelector<HTMLCanvasElement>('.hero__canvas');

  if (section && canvas) {
    const frameCount = Number(section.dataset.frameCount ?? '103');
    const loaderBar = section.querySelector<HTMLElement>('.hero__loader-bar span');

    const frames = new ScrollFrames({
      section,
      canvas,
      frameCount,
      framePath: (i) => `/frames/coffe-machine-detouching_out${String(i + 1).padStart(4, '0')}.png`,
      onProgress: (loaded, total) => {
        if (loaderBar) loaderBar.style.width = `${Math.round((loaded / total) * 100)}%`;
      },
      onReady: () => section.classList.add('hero--ready'),
    });

    frames.init();
  }

  // Кнопка звонка: копировать на десктопе, набирать на мобильном
  document.querySelectorAll<HTMLAnchorElement>('.btn-call').forEach((btn) => {
    const copiedEl = btn.closest('.hero__card, .hero__mobile')?.querySelector<HTMLElement>('.hero__copied');
    btn.addEventListener('click', (e) => {
      const isMobile = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (!isMobile) {
        e.preventDefault();
        navigator.clipboard.writeText(btn.dataset.phone ?? '').then(() => {
          if (copiedEl) {
            copiedEl.textContent = 'Номер скопирован';
            copiedEl.classList.add('visible');
            setTimeout(() => copiedEl.classList.remove('visible'), 2500);
          }
        });
      }
    });
  });
</script>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  // ─── Scroll-секция ───────────────────────────────────────────────

  .hero {
    position: relative;
    height: 320vh;

    @include reduced-motion {
      height: 100vh;
    }
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background-color: #fff;
  }

  .hero__canvas {
    width: 100%;
    height: 100%;
  }

  .hero__loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-color: #fff;
    transition:
      opacity $transition,
      visibility $transition;

    .hero--ready & {
      opacity: 0;
      visibility: hidden;
    }
  }

  .hero__loader-bar {
    width: min(220px, 60vw);
    height: 3px;
    background-color: #e0e0e0;
    border-radius: 99px;
    overflow: hidden;

    span {
      display: block;
      height: 100%;
      width: 0;
      background-color: $color-accent;
      transition: width 120ms linear;
    }
  }

  // ─── Десктопный оверлей ──────────────────────────────────────────

  .hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;

    // На мобильных не показываем оверлей
    display: none;

    @include respond-to(md) {
      display: block;
    }
  }

  .hero__card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    // Мутное стекло
    background: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: $radius;
    border: 1px solid rgba(255, 255, 255, 0.55);
    padding: $space-sm $space-md;
    pointer-events: auto;

    @include respond-to(lg) {
      bottom: 40px;
      left: 40px;
      padding: $space-md $space-lg;
    }
  }

  // ─── Мобильный блок (ниже секции) ───────────────────────────────

  .hero__mobile {
    display: block;
    padding: $space-lg $space-md;
    background: $color-surface;
    border-bottom: 1px solid $color-border;

    @include respond-to(md) {
      display: none;
    }
  }

  // ─── Общие элементы карточки ────────────────────────────────────

  .hero__eyebrow {
    @include tech-label;
    margin-bottom: $space-2xs;
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .hero__title {
    font-size: 1rem;
    line-height: 1.2;

    span {
      display: block;
      margin-top: 2px;
      font-family: $font-body;
      font-size: 0.75rem;
      font-weight: 400;
      line-height: 1.4;
    }
  }

  // Десктопная карточка — светлое стекло, текст тёмный
  .hero__card {
    color: $color-bg;

    .hero__title span { color: #444; }

    .btn--ghost {
      color: $color-bg;
      border-color: rgba(14, 17, 22, 0.3);

      &:hover {
        border-color: $color-accent;
        color: $color-accent;
      }
    }
  }

  // Мобильный блок — тёмный фон, текст светлый (глобальные цвета)
  .hero__mobile {
    color: $color-text;

    .hero__title span { color: $color-text-muted; }
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    margin-top: $space-xs;

    .btn {
      white-space: nowrap;
      justify-content: center;
    }
  }

  .hero__copied {
    @include tech-label;
    margin-top: $space-2xs;
    color: $color-accent;
    font-size: 0.65rem;
    min-height: 1em;
    opacity: 0;
    transition: opacity $transition;

    &.visible {
      opacity: 1;
    }
  }
</style>
